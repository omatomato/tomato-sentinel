{
  "contract_version": 1,
  "module_id": "lab.spectra",
  "version": 1,
  "display_name": "Spectra Lab (simulado)",
  "category": "spectra",
  "execution_location": "edge",
  "risk_class": "R1",
  "required_profile": "lab",
  "authorization_kind": "operation_scope",
  "required_roles": ["researcher"],
  "required_capabilities": ["synthetic_signal_analysis"],
  "required_hardware": [],
  "requires_confirmation": true,
  "requires_physical_confirmation": true,
  "maximum_duration_seconds": 120,
  "maximum_samples": 65536,
  "supports_cancel": true,
  "executor_id": "executor:spectra-fixture-v1",
  "parameters_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "encoding",
      "duration_seconds",
      "sample_count",
      "noise_percent"
    ],
    "properties": {
      "encoding": {"enum": ["manchester", "fsk", "ask", "pwm"]},
      "duration_seconds": {"type": "integer", "minimum": 1, "maximum": 120},
      "sample_count": {"type": "integer", "minimum": 8, "maximum": 65536},
      "noise_percent": {"type": "integer", "minimum": 0, "maximum": 50}
    },
    "unevaluatedProperties": false
  },
  "result_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "execution_mode",
      "encoding",
      "sample_count",
      "bit_errors",
      "ber",
      "checksum_ok"
    ],
    "properties": {
      "execution_mode": {"const": "simulation"},
      "encoding": {"enum": ["manchester", "fsk", "ask", "pwm"]},
      "sample_count": {"type": "integer", "minimum": 8, "maximum": 65536},
      "bit_errors": {"type": "integer", "minimum": 0},
      "ber": {"type": "number", "minimum": 0, "maximum": 1},
      "checksum_ok": {"type": "boolean"}
    },
    "unevaluatedProperties": false
  }
}
