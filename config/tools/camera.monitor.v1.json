{
  "contract_version": 1,
  "tool_id": "camera.monitor",
  "version": 1,
  "category": "sentinel",
  "execution_location": "edge",
  "interaction_modes": ["passive_observation"],
  "risk_class": "R1",
  "required_profile": "sentinel",
  "authorization_kind": "resource_grant",
  "required_roles": ["operator"],
  "required_capabilities": ["camera_monitoring"],
