  "requires_physical_confirmation": false,
  "timeout_seconds": 330,
  "maximum_duration_seconds": 300,
  "maximum_targets": 1,
  "parameters_schema": {
    "type": "object",
    "required": ["duration_seconds"],
    "properties": {
      "duration_seconds": {
        "type": "integer",
        "minimum": 1,
        "maximum": 300
      }
    },
    "unevaluatedProperties": false
  },
  "result_schema": {
    "type": "object",
    "required": ["job_id", "status"],
    "properties": {
      "job_id": {
        "type": "string"
      },
      "status": {
        "enum": ["created", "running", "completed", "cancelled", "failed"]
      }
    },
    "unevaluatedProperties": false
