{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tomato-sentinel.invalid/v1/command.schema.json",
  "title": "Structured command",
  "type": "object",
  "required": [
    "contract_version",
    "command_id",
    "actor_id",
    "organization_id",
    "source_device_id",
    "profile",
    "action",
    "targets",
    "parameters",
    "requested_at"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "command_id": {
      "$ref": "#/$defs/typed_id"
    },
    "actor_id": {
      "$ref": "#/$defs/typed_id"
    },
    "organization_id": {
      "$ref": "#/$defs/typed_id"
    },
    "source_device_id": {
      "$ref": "#/$defs/typed_id"
    },
    "profile": {
      "enum": ["assistant", "sentinel", "inventory", "lab", "recovery"]
    },
    "action": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9_]*)+$",
      "maxLength": 128
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/typed_id"
      }
    },
    "parameters": {
      "type": "object",
      "maxProperties": 32
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "$ref": "#/$defs/typed_id"
    }
  },
  "$defs": {
    "typed_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9][A-Za-z0-9._-]*$",
      "maxLength": 160
    }
  },
  "unevaluatedProperties": false
}
