{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tomato-sentinel.invalid/v1/discovery-candidate.schema.json",
  "title": "Untrusted passive discovery candidate",
  "type": "object",
  "required": [
    "contract_version",
    "candidate_id",
    "observer_id",
    "network_id",
    "interface_id",
    "protocols",
    "probable_types",
    "authentication_required",
    "first_observed_at",
    "last_observed_at",
    "confidence",
    "enrollment_status",
    "execution_mode"
  ],
  "properties": {
    "contract_version": {"const": 1},
    "candidate_id": {"$ref": "#/$defs/typed_id"},
    "observer_id": {"$ref": "#/$defs/typed_id"},
    "network_id": {"$ref": "#/$defs/typed_id"},
    "interface_id": {"$ref": "#/$defs/typed_id"},
    "protocols": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "arp_cache",
          "dhcp_lease",
          "mdns_announcement",
          "ssdp_notification",
          "ws_discovery_announcement"
        ]
      }
    },
    "probable_types": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": ["camera", "edge_node", "network_device", "sensor", "unknown"]
      }
    },
    "authentication_required": {"type": ["boolean", "null"]},
    "first_observed_at": {"type": "string", "format": "date-time"},
    "last_observed_at": {"type": "string", "format": "date-time"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "enrollment_status": {"const": "candidate"},
    "execution_mode": {"const": "simulated"}
  },
  "$defs": {
    "typed_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9][A-Za-z0-9._-]*$",
      "maxLength": 160
    }
  },
  "unevaluatedProperties": false
}
