{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tomato-sentinel.invalid/v1/experiment-proposal.schema.json",
  "title": "Untrusted local AI experiment proposal",
  "type": "object",
  "required": [
    "contract_version",
    "module_alias",
    "target_alias",
    "fixture_aliases",
    "parameters",
    "execution_mode"
  ],
  "properties": {
    "contract_version": {"const": 1},
    "module_alias": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$",
      "maxLength": 64
    },
    "target_alias": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$",
      "maxLength": 64
    },
    "fixture_aliases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$",
        "maxLength": 64
      }
    },
    "parameters": {
      "type": "object",
      "maxProperties": 32
    },
    "execution_mode": {"const": "simulation"}
  },
  "unevaluatedProperties": false
}
