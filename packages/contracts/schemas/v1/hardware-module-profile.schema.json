{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tomato-sentinel.invalid/v1/hardware-module-profile.schema.json",
  "title": "Inactive physical hardware module profile",
  "type": "object",
  "required": [
    "contract_version",
    "hardware_id",
    "version",
    "display_name",
    "compatible_board_profiles",
    "bus",
    "interaction_modes",
    "activation_state",
    "wiring_status",
    "pins",
    "driver_status",
    "transmit_permitted",
    "write_permitted",
    "electrical_review_status",
    "tested_on_hardware"
  ],
  "properties": {
    "contract_version": {"const": 1},
    "hardware_id": {
      "type": "string",
      "pattern": "^hardware:[A-Za-z0-9][A-Za-z0-9._-]*$",
      "maxLength": 160
    },
    "version": {"type": "integer", "minimum": 1},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 80},
    "compatible_board_profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^board-profile:[A-Za-z0-9][A-Za-z0-9._-]*$",
        "maxLength": 160
      }
    },
    "bus": {"enum": ["spi", "i2c", "adc", "gpio"]},
    "interaction_modes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": ["receive_only", "read_only", "sensor_input"]
      }
    },
    "activation_state": {"const": "disabled"},
    "wiring_status": {"const": "unassigned"},
    "pins": {"type": "array", "maxItems": 0},
    "driver_status": {"const": "not_integrated"},
    "transmit_permitted": {"const": false},
    "write_permitted": {"const": false},
    "electrical_review_status": {"const": "pending"},
    "tested_on_hardware": {"const": false}
  },
  "unevaluatedProperties": false
}
