{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tomato-sentinel.invalid/v1/lab-dashboard-request.schema.json",
  "title": "Signed Cardputer lab dashboard request",
  "type": "object",
  "required": [
    "contract_version",
    "request_id",
    "organization_id",
    "source_device_id",
    "active_profile",
    "scope_id",
    "action",
    "parameters",
    "requested_at",
    "correlation_id"
  ],
  "properties": {
    "contract_version": {"const": 1},
    "request_id": {"$ref": "#/$defs/typed_id"},
    "organization_id": {"$ref": "#/$defs/typed_id"},
    "source_device_id": {"$ref": "#/$defs/typed_id"},
    "active_profile": {"const": "lab"},
    "scope_id": {
      "type": "string",
      "pattern": "^scope:[A-Za-z0-9][A-Za-z0-9._-]*$",
      "maxLength": 160
    },
    "action": {
      "enum": ["lab.dashboard.capabilities", "lab.experiment.proposal"]
    },
    "parameters": {"type": "object", "maxProperties": 1},
    "requested_at": {"type": "string", "format": "date-time"},
    "correlation_id": {"$ref": "#/$defs/typed_id"}
  },
  "$defs": {
    "typed_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9][A-Za-z0-9._-]*$",
      "maxLength": 160
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"action": {"const": "lab.dashboard.capabilities"}},
        "required": ["action"]
      },
      "then": {"properties": {"parameters": {"const": {}}}}
    },
    {
      "if": {
        "properties": {"action": {"const": "lab.experiment.proposal"}},
        "required": ["action"]
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "required": ["prompt_id"],
            "properties": {
              "prompt_id": {
                "type": "string",
                "pattern": "^prompt:[A-Za-z0-9][A-Za-z0-9._-]*$",
                "maxLength": 160
              }
            },
            "unevaluatedProperties": false
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
