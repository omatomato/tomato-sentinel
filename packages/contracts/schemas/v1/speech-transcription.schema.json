{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tomato-sentinel.invalid/v1/speech-transcription.schema.json",
  "title": "Normalized speech transcription",
  "type": "object",
  "required": [
    "contract_version",
    "transcription_id",
    "provider_id",
    "execution_mode",
    "language",
    "text",
    "audio_sha256",
    "created_at"
  ],
  "properties": {
    "contract_version": {"const": 1},
    "transcription_id": {"$ref": "#/$defs/typed_id"},
    "provider_id": {"const": "speech-provider:fixture-v1"},
    "execution_mode": {"const": "simulated"},
    "language": {"const": "pt-BR"},
    "text": {"type": "string", "minLength": 1, "maxLength": 512},
    "audio_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "typed_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9][A-Za-z0-9._-]*$",
      "maxLength": 160
    }
  },
  "unevaluatedProperties": false
}
