{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tomato-sentinel.invalid/v1/voice-command.schema.json",
  "title": "Bounded push-to-talk voice command",
  "type": "object",
  "required": [
    "contract_version",
    "capture_id",
    "recorded_at",
    "completed_at",
    "audio",
    "retention"
  ],
  "properties": {
    "contract_version": {"const": 1},
    "capture_id": {"$ref": "#/$defs/typed_id"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "audio": {
      "type": "object",
      "required": [
        "encoding",
        "sample_rate",
        "channels",
        "duration_ms",
        "byte_length",
        "content_base64"
      ],
      "properties": {
        "encoding": {"const": "opus"},
        "sample_rate": {"const": 16000},
        "channels": {"const": 1},
        "duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15000
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18000
        },
        "content_base64": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "maxLength": 24000
        }
      },
      "unevaluatedProperties": false
    },
    "retention": {"const": "delete_after_processing"}
  },
  "$defs": {
    "typed_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9][A-Za-z0-9._-]*$",
      "maxLength": 160
    }
  },
  "unevaluatedProperties": false
}
